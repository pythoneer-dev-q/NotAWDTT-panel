# ==============================================================================
# WDTT Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. База данных MongoDB
# ------------------------------------------------------------------------------
# Локальная база:
MONGODB_URI=mongodb://127.0.0.1:27017/wdtt

# Удалённая база данных (например, на отдельном сервере или в Docker/MongoDB Atlas):
# MONGODB_URI=mongodb://username:password@mongodb-host:27017/wdtt?authSource=admin
WDTT_LOG_LEVEL=info
WDTT_PROJECT_NAME=WDTT

# Имя рабочей базы данных (по умолчанию: wdtt)
MONGODB_DATABASE=wdtt

# ------------------------------------------------------------------------------
# 2. Веб-панель управления
# ------------------------------------------------------------------------------
# Порт и адрес веб-панели (по умолчанию: http://IP:2860/wdtt/)
WDTT_PANEL_PORT=2860
WDTT_PANEL_LISTEN=0.0.0.0

# Порт сервера подписок /sub/
WDTT_SUB_PORT=2096

# Первичные учетные данные администратора панели (при чистом запуске)
WDTT_PANEL_USER=admin
WDTT_PANEL_PASSWORD=wdtt

# ------------------------------------------------------------------------------
# 3. Порты VPN-ядра (RAW & UDP)
# ------------------------------------------------------------------------------
# Основной защищённый порт DTLS (UDP)
WDTT_DTLS_PORT=56000

# Порт прямого режима RAW Direct (UDP, максимальная скорость без оверхеда)
WDTT_RAW_PORT=56003

# Сетевой интерфейс и подсеть для RAW TUN
WDTT_RAW_IFACE=wdtt-raw
WDTT_RAW_NET=10.70.0.0/16
WDTT_MTU=1280
WDTT_DNS=1.1.1.1,8.8.8.8

# ------------------------------------------------------------------------------
# 4. Системные настройки
# ------------------------------------------------------------------------------
# Рабочая директория с сертификатами и вспомогательными файлами
WDTT_CONFIG_DIR=/etc/wdtt

# Главный пароль владельца VPN (если не задан, генерируется автоматически)
# WDTT_MAIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Telegram-бот (REST API v2)
# ------------------------------------------------------------------------------
# Включите после заполнения токена и Telegram ID администраторов.
WDTT_BOT_ENABLED=false
WDTT_BOT_TOKEN=
WDTT_BOT_ADMIN_IDS=

# Локальный REST API панели. Для удалённого бота укажите HTTPS URL до /api.
WDTT_BOT_PANEL_URL=http://127.0.0.1:2860/api
# Необязательно: пустое значение использует сгенерированный API-ключ панели.
WDTT_BOT_API_KEY=

# Пользовательский кабинет и соответствие Telegram ID пользователю tg_<id>.
WDTT_BOT_PUBLIC=true
WDTT_BOT_USER_PREFIX=tg_

# До пяти нод выводятся CopyTextButton; остальные остаются в подписке.
WDTT_BOT_COPY_NODE_LIMIT=5
WDTT_BOT_DEFAULT_DAYS=30
WDTT_BOT_DEFAULT_TRAFFIC_GB=100
WDTT_BOT_DEFAULT_DEVICES=2
WDTT_BOT_REQUEST_TIMEOUT_SEC=15

# Можно заменить для локального Bot API Server или прокси.
WDTT_BOT_TELEGRAM_API=https://api.telegram.org
