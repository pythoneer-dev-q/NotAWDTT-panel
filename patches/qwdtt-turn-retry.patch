+func turnURLsForAttempt(urls []string, attempt int) []string {
+	if len(urls) < 2 {
+		return urls
+	}
+	shift := attempt % len(urls)
+	if shift == 0 {
+		return urls
+	}
+	rotated := make([]string, 0, len(urls))
+	rotated = append(rotated, urls[shift:]...)
+	return append(rotated, urls[:shift]...)
+}
