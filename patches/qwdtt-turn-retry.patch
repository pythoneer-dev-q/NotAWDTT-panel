--- /dev/null
+++ b/go_client/group_test.go
@@ -0,0 +1,16 @@
+package main
+
+import "testing"
+
+func TestTurnURLsForAttemptVisitsEveryRelay(t *testing.T) {
+	urls := []string{"first:19302", "second:19302", "third:19302"}
+	for attempt, want := range []string{"first:19302", "second:19302", "third:19302", "first:19302"} {
+		rotated := turnURLsForAttempt(urls, attempt)
+		if got := rotated[0]; got != want {
+			t.Fatalf("attempt %d: first relay = %q, want %q", attempt, got, want)
+		}
+	}
+	if urls[0] != "first:19302" {
+		t.Fatal("rotation mutated credential relay list")
+	}
+}
