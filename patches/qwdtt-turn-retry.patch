--- /dev/null
+++ b/go_client/protocol_test.go
@@ -0,0 +1,29 @@
+package main
+
+import (
+	"net"
+	"strings"
+	"testing"
+)
+
+func TestRequestConfigSendsDeviceName(t *testing.T) {
+	t.Setenv("WDTT_DEVICE_NAME", "Samsung Galaxy S")
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	payload := make(chan string, 1)
+	go func() {
+		buf := make([]byte, 512)
+		n, err := server.Read(buf)
+		if err == nil {
+			payload <- string(buf[:n])
+			_, _ = server.Write([]byte("NOCONF"))
+		}
+	}()
+	if _, err := RequestConfig(client, "9000", "device", "password"); err != nil {
+		t.Fatal(err)
+	}
+	if got := <-payload; !strings.HasSuffix(got, "|Samsung+Galaxy+S") {
+		t.Fatalf("device name missing from GETCONF: %q", got)
+	}
+}
